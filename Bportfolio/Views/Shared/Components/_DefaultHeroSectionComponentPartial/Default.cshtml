<section id="home">
      <div class="container">
        <div class="row align-items-center gy-5">
          <!-- Left Column -->
          <div class="col-lg-7 reveal-on-scroll is-revealed">
            <div class="eyebrow-badge">
              <i class="bi bi-hand-wave-fill"></i> @ViewBag.Greeting
            </div>
            
            <h1 class="hero-title">
              @ViewBag.Title
            </h1>

            <div class="typewriter-wrapper">
              <span id="typewriterText"></span><span class="typing-cursor"></span>
            </div>

            <p class="hero-lead">
              @ViewBag.Description
            </p>

            <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
              <a href="#projects" class="btn-sage">
                <span>Projelerimi Keşfet</span>
                <i class="bi bi-arrow-down-right"></i>
              </a>
              <a href="#contact" class="btn-secondary-custom">
                <span>Benimle İletişime Geç</span>
                <i class="bi bi-chat-text"></i>
              </a>
            </div>

          </div>

          <!-- Right Column -->
          <div class="col-lg-5 reveal-on-scroll is-revealed">
            <div class="position-relative mx-auto" style="max-width: 440px;">
              <div class="hero-portrait-frame">
                @if (!string.IsNullOrWhiteSpace(ViewBag.MainImageUrl as string))
                {
                  <img src="@Url.Content($"~/img/{System.IO.Path.GetFileName((string)ViewBag.MainImageUrl)}")"
                       alt="Profil görseli" class="hero-portrait-img">
                }
              </div>

              <!-- Focus badge -->
              <div class="floating-badge floating-badge-bottom">
                <div class="skill-icon-box mb-0"
                     style="width: 42px; height: 42px; background: var(--accent-sage-soft); color: var(--accent-sage-dark);">
                  <i class="bi bi-code-slash"></i>
                </div>
                <div>
                  <div class="fw-bold font-heading fs-6">C# / .NET</div>
                  <div class="text-muted small">Backend geliştirme</div>
                </div>
              </div>

              <!-- Focus badge -->
              <div class="floating-badge floating-badge-top d-none d-sm-flex">
                <div class="skill-icon-box mb-0"
                     style="width: 38px; height: 38px; background: var(--accent-terracotta-soft); color: var(--accent-terracotta);">
                  <i class="bi bi-database"></i>
                </div>
                <div>
                  <div class="fw-bold font-heading small">SQL</div>
                  <div class="text-muted" style="font-size: 0.72rem;">Veri odaklı çözümler</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Scroll Indicator -->
        <div class="text-center mt-5 pt-4">
          <a href="#about" class="scroll-indicator">
            <div class="scroll-mouse">
              <div class="scroll-dot"></div>
            </div>
            <span>Aşağı Kaydır</span>
          </a>
        </div>
      </div>
    </section>