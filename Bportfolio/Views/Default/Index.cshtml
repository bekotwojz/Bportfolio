@{
  var contactFormStatus = TempData["ContactFormStatus"] as string;
}
<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_DefaultHeaderComponentPartial")

<body>

  <!-- Fixed Navigation Bar -->
  
  @await Component.InvokeAsync("_DefaultNavbarComponentPartial")

  <main>
    <!-- 4. Hero Section -->
    @await Component.InvokeAsync("_DefaultHeroSectionComponentPartial")

    <!-- 5. About Me Section -->
    <section id="about" class="bg-white border-top border-bottom">
      <div class="container">
        <div class="row align-items-center gy-5">
          <!-- Left Column: Portrait and visual composition -->
          <div class="col-lg-5 reveal-on-scroll">
            <div class="about-img-wrap">
              <img
              src="~/img/IMG_0299.PNG"
              alt="Berkay Zengin portresi" class="w-100"
              style="height: 540px; object-fit: cover; object-position: center top;">
              <div class="p-3 bg-light border-top d-flex align-items-center justify-content-between">
                <span class="small text-muted font-heading">Berkay Zengin</span>
                <span class="badge bg-secondary-subtle text-dark fw-medium">Backend Geliştirme</span>
              </div>
            </div>
          </div>

          <!-- Right Column: Story & Stats -->
          <div class="col-lg-7 ps-lg-5 reveal-on-scroll">
            <div class="eyebrow-badge">
              <i class="bi bi-person-lines-fill"></i> BENİ TANIYIN
            </div>
            <h2 class="section-title">
              Sağlam temeller üzerine kurulu çözümler geliştiriyorum.
            </h2>
            <div class="text-muted fs-5 mb-4 lh-base">
              <p class="mb-3">
                Merhaba, ben <strong>Berkay Zengin</strong>. C# ve <strong>ASP.NET Core</strong> ile web uygulamaları
                geliştiriyorum. Özellikle backend süreçleri, veritabanı tasarımı ve uygulama katmanlarının birlikte
                çalışmasıyla ilgileniyorum.
              </p>
              <p class="mb-4">
                Her projede önce ihtiyacı anlamaya; ardından okunabilir, sürdürülebilir kodla güvenilir bir çözüm
                oluşturmaya odaklanıyorum. Öğrendiklerimi gerçek projelerde uygulayarak kendimi geliştirmeyi ve her
                çalışmada daha iyi bir sonuç ortaya koymayı önemsiyorum.
              </p>
            </div>

            <!-- Focus areas -->
            <div class="row g-4 pt-2 pb-4 border-top border-bottom mb-4">
              <div class="col-4">
                <div class="stat-number">C#</div>
                <div class="stat-label">Backend</div>
              </div>
              <div class="col-4">
                <div class="stat-number">.NET</div>
                <div class="stat-label">Web uygulamaları</div>
              </div>
              <div class="col-4">
                <div class="stat-number">SQL</div>
                <div class="stat-label">Veri yönetimi</div>
              </div>
            </div>

            <div class="d-flex align-items-center gap-3">
              <a href="#contact" class="btn-secondary-custom">
                <span>Bana Ulaşın</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    @await Component.InvokeAsync("_DefaultSkillComponentPartial")

                <!-- 7. Professional Experience Section -->
                @await Component.InvokeAsync("_DefaultExperienceComponentPartial")

                    <!-- 8. Featured Projects Section -->
                    <section id="projects">
                      <div class="container">
                        <div
                          class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3 reveal-on-scroll">
                          <div>
                            <div class="eyebrow-badge">
                              <i class="bi bi-folder-check"></i> SEÇİLMİŞ ÇALIŞMALAR
                            </div>
                            <h2 class="section-title mb-1">
                              Fikirden Ürüne Dönüşen Projeler
                            </h2>
                            <p class="section-description mb-0">
                              Öğrenme, üretme ve problem çözme süreçlerimin birer yansıması olan projelerimden bazıları.
                            </p>
                          </div>

                          <!-- Filter Buttons -->
                          <div class="d-flex flex-wrap gap-2" id="projectFilters">
                            <button class="filter-btn active" data-filter="all">Tümü</button>
                            <button class="filter-btn" data-filter="web">Web Uygulamaları</button>
                            <button class="filter-btn" data-filter="ai">Yapay Zeka</button>
                            <button class="filter-btn" data-filter="mobile">Mobil</button>
                            <button class="filter-btn" data-filter="microservices">Mikroservisler</button>
                          </div>
                        </div>

                        <!-- Project Grid -->
                        @await Component.InvokeAsync("_DefaultProjectComponentPartial")

                        <div class="text-center mt-5">
                          <a href="#contact" class="btn-secondary-custom px-4 py-3">
                            <span>Tüm Projelerimi Gör</span>
                            <i class="bi bi-arrow-right"></i>
                          </a>
                        </div>
                      </div>
                    </section>

                    <!-- 9. Education Section -->
                    
                    @await Component.InvokeAsync("_DefaultEducationComponentPartial")

                    <!-- 10. Personal Philosophy Section -->
                    <section class="philosophy-section text-center">
                      <div class="container">
                        <div class="mx-auto reveal-on-scroll" style="max-width: 820px;">
                          <div class="mb-3 text-secondary" style="font-size: 2.5rem; line-height: 1;">
                            <i class="bi bi-code-slash text-light opacity-50"></i>
                          </div>
                          <p class="philosophy-quote mb-4">
                            "İyi yazılım yalnızca çalışan kod değil, gerçek bir probleme üretilmiş anlamlı bir çözümdür."
                          </p>
                          <div class="d-inline-flex align-items-center gap-2 text-white-50 small font-heading">
                            <span class="w-12 h-px bg-white-50"></span>
                            <span>Berkay Zengin — Yazılım Felsefesi</span>
                          </div>
                        </div>
                      </div>
                    </section>

                    <!-- 11. Contact Section -->
                    <section id="contact">
                      <div class="container">
                        <div class="row gy-5">
                          <!-- Left Column: Contact Info -->
                          <div class="col-lg-5 reveal-on-scroll">
                            <div class="eyebrow-badge">
                              <i class="bi bi-envelope-paper-fill"></i> İLETİŞİME GEÇELİM
                            </div>
                            <h2 class="section-title">
                              Harika Bir Fikrin mi Var? Birlikte Hayata Geçirelim.
                            </h2>
                            <p class="text-muted mb-4 fs-6">
                              Proje, iş birliği veya teknoloji üzerine görüşmek için mesaj gönderebilirsin.
                            </p>
                          </div>

                          <!-- Right Column: Form -->
                          <div class="col-lg-7 ps-lg-5 reveal-on-scroll">
                            <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm">
                              <form id="contactForm" asp-controller="Default" asp-action="SendMessage" method="post">
                                @Html.AntiForgeryToken()
                                <div class="row g-3">
                                  <div class="col-md-6">
                                    <label for="fullName" class="form-label small fw-semibold">Adınız Soyadınız *</label>
                                    <input type="text" class="form-control form-control-custom" id="fullName" name="SenderName" maxlength="200"
                                           placeholder="Örn: Ahmet Yılmaz" required>
                                  </div>
                                  <div class="col-md-6">
                                    <label for="emailAddr" class="form-label small fw-semibold">E-posta Adresiniz *</label>
                                    <input type="email" class="form-control form-control-custom" id="emailAddr" name="SenderEmail" maxlength="200"
                                           placeholder="ad@ornek.com" required>
                                  </div>
                                  <div class="col-12">
                                    <label for="subject" class="form-label small fw-semibold">Konu</label>
                                    <input type="text" class="form-control form-control-custom" id="subject" name="Subject" maxlength="200"
                                           placeholder="Örn: Kurumsal .NET Eğitimi veya Danışmanlık">
                                  </div>
                                  <div class="col-12">
                                    <label for="message" class="form-label small fw-semibold">Mesajınız *</label>
                                    <textarea class="form-control form-control-custom" id="message" name="MessageDetail" rows="5" maxlength="4000"
                                              placeholder="Projeniz veya sorunuz hakkında detayları paylaşın..." required></textarea>
                                  </div>
                                  <div class="col-12 pt-2">
                                    <button type="submit" class="btn-sage w-100 justify-content-center py-3 fs-6">
                                      <i class="bi bi-send-fill"></i>
                                      <span>Mesajımı Gönder</span>
                                    </button>
                                    @if (contactFormStatus == "success")
                                    {
                                      <div class="alert alert-success mt-3 mb-0" role="status">Mesajınız başarıyla gönderildi.</div>
                                    }
                                    else if (contactFormStatus == "error")
                                    {
                                      <div class="alert alert-danger mt-3 mb-0" role="alert">Mesaj gönderilemedi. Bilgilerinizi kontrol edip tekrar deneyin.</div>
                                    }
                                    <div class="text-muted text-center small mt-3" style="font-size: 0.78rem;">
                                      <i class="bi bi-shield-check me-1"></i> Gönderilen bilgiler gizlilik ilkeleri doğrultusunda
                                      korunmaktadır.
                                    </div>
                                  </div>
                                </div>
                              </form>
                            </div>
                          </div>
                        </div>
                      </div>
                    </section>
                  </main>

                  <!-- 12. Footer -->
                  <footer class="site-footer">
                    <div class="container">
                      <div class="d-flex flex-column flex-md-row align-items-center justify-content-between pb-4 border-bottom gap-3">
                        <div>
                          <a class="navbar-brand-custom" href="#home">
                            <span>Berkay Zengin.</span>
                          </a>
                          <p class="text-muted small mb-0 mt-1">Kod, yaratıcılık ve sürekli öğrenme.</p>
                        </div>

                        <!-- Quick Links -->
                        <div class="d-flex gap-3">
                          <a href="#home" class="text-decoration-none text-muted small fw-medium">Ana Sayfa</a>
                          <a href="#about" class="text-decoration-none text-muted small fw-medium">Hakkımda</a>
                          <a href="#projects" class="text-decoration-none text-muted small fw-medium">Projelerim</a>
                          <a href="#contact" class="text-decoration-none text-muted small fw-medium">İletişim</a>
                        </div>

                        <button class="back-to-top-btn" id="backToTop" title="Yukarı Çık">
                          <i class="bi bi-arrow-up"></i>
                        </button>
                      </div>

                      <div class="d-flex flex-column flex-md-row justify-content-between align-items-center pt-3 gap-2">
                        <div class="text-muted small">
                          © @DateTime.Now.Year Berkay Zengin. Tüm hakları saklıdır.
                        </div>
                      </div>
                    </div>
                  </footer>

                  <!-- Bootstrap 5 JS Bundle -->
                  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

                  <!-- Vanilla JavaScript for Interactivity -->
                  <script>
                      // 1. Typewriter Animation for Hero Section
                      (function initTypewriter() {
                        const phrases = [
                          "Yazılım Geliştiricisi",
                          ".NET Eğitmeni",
                          "Teknoloji İçerik Üreticisi",
                          "Yapay Zeka Meraklısı",
                          "Yazılım Mimarı"
                        ];
                        const targetElement = document.getElementById("typewriterText");
                        if (!targetElement) return;

                        let phraseIndex = 0;
                        let charIndex = 0;
                        let isDeleting = false;
                        const typeSpeed = 80;
                        const deleteSpeed = 40;
                        const delayBetween = 1800;

                        function typeCycle() {
                          const currentPhrase = phrases[phraseIndex];
                          if (isDeleting) {
                            targetElement.textContent = currentPhrase.substring(0, charIndex - 1);
                            charIndex--;
                          } else {
                            targetElement.textContent = currentPhrase.substring(0, charIndex + 1);
                            charIndex++;
                          }

                          if (!isDeleting && charIndex === currentPhrase.length) {
                            setTimeout(() => {
                              isDeleting = true;
                              typeCycle();
                            }, delayBetween);
                            return;
                          } else if (isDeleting && charIndex === 0) {
                            isDeleting = false;
                            phraseIndex = (phraseIndex + 1) % phrases.length;
                            setTimeout(typeCycle, 300);
                            return;
                          }

                          setTimeout(typeCycle, isDeleting ? deleteSpeed : typeSpeed);
                        }

                        typeCycle();
                      })();

                      // 2. Fixed Navbar on Scroll
                      window.addEventListener("scroll", function () {
                        const navbar = document.getElementById("mainNavbar");
                        if (window.scrollY > 40) {
                          navbar.classList.add("scrolled");
                        } else {
                          navbar.classList.remove("scrolled");
                        }
                      });

                      // 3. Active Nav Link on Scroll Spy
                      const sections = document.querySelectorAll("section[id]");
                      const navLinks = document.querySelectorAll(".nav-link-custom");

                      function updateActiveNav() {
                        const scrollY = window.pageYOffset;
                        sections.forEach(current => {
                          const sectionHeight = current.offsetHeight;
                          const sectionTop = current.offsetTop - 120;
                          const sectionId = current.getAttribute("id");

                          if (scrollY > sectionTop && scrollY <= sectionTop + sectionHeight) {
                            navLinks.forEach(link => {
                              link.classList.remove("active");
                              if (link.getAttribute("href") === "#" + sectionId) {
                                link.classList.add("active");
                              }
                            });
                          }
                        });
                      }
                      window.addEventListener("scroll", updateActiveNav);

                      // 4. Mobile Menu Auto-close on click
                      document.querySelectorAll(".mobile-nav-link").forEach(link => {
                        link.addEventListener("click", () => {
                          const mobileMenu = document.getElementById("mobileMenu");
                          if (mobileMenu && mobileMenu.classList.contains("show")) {
                            const bsCollapse = bootstrap.Collapse.getInstance(mobileMenu);
                            if (bsCollapse) bsCollapse.hide();
                          }
                        });
                      });

                      // 5. Project Filtering (Vanilla JS)
                      const filterButtons = document.querySelectorAll("#projectFilters .filter-btn");
                      const projectItems = document.querySelectorAll("#projectGrid .project-item");

                      filterButtons.forEach(btn => {
                        btn.addEventListener("click", () => {
                          filterButtons.forEach(b => b.classList.remove("active"));
                          btn.classList.add("active");

                          const filterValue = btn.getAttribute("data-filter");
                          projectItems.forEach(item => {
                            const categories = item.getAttribute("data-category") || "";
                            if (filterValue === "all" || categories.includes(filterValue)) {
                              item.style.display = "block";
                              item.style.opacity = "1";
                            } else {
                              item.style.display = "none";
                              item.style.opacity = "0";
                            }
                          });
                        });
                      });

                      // 6. Back to Top Button
                      const backToTopBtn = document.getElementById("backToTop");
                      if (backToTopBtn) {
                        backToTopBtn.addEventListener("click", () => {
                          window.scrollTo({ top: 0, behavior: "smooth" });
                        });
                      }

                      // 7. Intersection Observer for Scroll Reveals
                      const revealElements = document.querySelectorAll(".reveal-on-scroll");
                      const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                          if (entry.isIntersecting) {
                            entry.target.classList.add("is-revealed");
                            observer.unobserve(entry.target);
                          }
                        });
                      }, {
                        threshold: 0.1,
                        rootMargin: "0px 0px -40px 0px"
                      });

                      revealElements.forEach(el => observer.observe(el));

                  </script>
                </body>

              </html>