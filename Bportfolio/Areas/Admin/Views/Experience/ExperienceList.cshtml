@using Microsoft.Identity.Client
@model List<Experience>

<main class="page-content-area">
    <div class="content-header-row">
        <div>
            <h1 class="page-title">Deneyimlerim Yönetimi</h1>
            <p class="page-subtitle">Portfolyo sitenizde yer alacak deneyim içeriklerini buradan yönetebilirsiniz.</p>
        </div>
    </div>

    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-green">
                <i class="bi bi-briefcase"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Toplam Deneyim</span>
                <h3 class="stat-value">4</h3>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-blue">
                <i class="bi bi-check2-circle"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Aktif Kayıt</span>
                <h3 class="stat-value">3</h3>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-beige">
                <i class="bi bi-pause-circle"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Pasif Kayıt</span>
                <h3 class="stat-value">1</h3>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-purple">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Son Güncelleme</span>
                <h3 class="stat-value" style="font-size: 1.05rem; font-weight: 700; line-height: 1.4;">12 Ekim 2026</h3>
            </div>
        </div>
    </div>

    <div class="data-table-card">
        <div class="table-filter-bar">

        <div class="table-responsive-wrapper">
            <table class="custom-admin-table experience-table">
                <thead>
                    <tr>
                        <th>Deneyim Başlığı</th>
                        <th>Kurum / Şirket</th>
                        <th>Kategori</th>
                        <th>Durum</th>
                        <th style="text-align: right; width: 140px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="experience-table-body">
                    @foreach (var item in Model)
                    {
                        var statusText = item.IsActive ? "Aktif" : "Pasif";
                        var statusClass = item.IsActive ? "active" : "passive";

                        <tr data-status="@statusText">
                            <td>
                                <div class="experience-title-cell">
                                    <div class="exp-icon-bullet">
                                        <i class="bi bi-laptop"></i>
                                    </div>
                                    <div>
                                        <span class="exp-title-text">@item.Title</span>
                                        <small class="text-muted d-block" style="font-size: 0.75rem;">React, TypeScript, CSS
                                            Mimarisi</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="company-cell">
                                        <i class="bi bi-building company-badge-icon"></i>
                                        <span>@item.CompanyName</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="work-type-badge">@item.CategoryName</span>
                                </td>
                                <td>
                                    <span class="status-pill status-@statusClass">@statusText</span>
                                </td>
                                <td style="text-align: right;">
                                    <div class="row-actions-group justify-content-end">
                                        <a asp-route-id="@item.ExperienceId" asp-action="EditExperience"
                                           class="btn-action-icon btn-edit" title="Güncelle">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button type="button" class="btn-action-icon btn-delete experience-delete-trigger"
                                            data-experience-id="@item.ExperienceId" data-experience-title="@item.Title"
                                            title="Sil" aria-label="@item.Title deneyimini sil">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>

        <div class="side-drawer-card">
            <div class="drawer-header">
                <div>
                    <h3 class="drawer-title">
                        <i class="bi bi-plus-square"></i>
                        Hızlı Deneyim Oluşturma Paneli
                    </h3>
                    <span class="text-secondary" style="font-size: 0.8rem;">Bu form, sayfa içi veya modal olarak ASP.NET
                        Core MVC ViewModel'e doğrudan bind edilebilir.</span>
                    </div>
                </div>

        <form method="post" asp-controller="Experience" asp-action="CreateExperience">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label-custom">
                        Deneyim Başlığı <span class="required-star">*</span>
                        <input name="Title" type="text" class="form-control-custom" placeholder="Örn: Senior Full Stack Developer" required>
                    </label>
                </div>
                <div class="col-md-6">
                    <label class="form-label-custom">
                        Şirket / Kurum Adı <span class="required-star">*</span>
                        <input name="CompanyName" type="text" class="form-control-custom" placeholder="Örn: Acme Tech Ltd." required>
                    </label>
                </div>
                <div class="col-12">
                    <label class="form-label-custom">
                        Açıklama / Görev Kapsamı
                        <textarea name="Description" class="form-control-custom" rows="2" placeholder="Üstlenilen sorumluluklar, kullanılan teknolojiler ve başarılar..."></textarea>
                    </label>
                </div>
                <div class="col-md-4">
                    <label class="form-label-custom">
                        Kategori
                        <select asp-items="ViewBag.categories" name="CategoryId" class="form-control-custom" required>
                            <option value="">Seçiniz (Zorunlu)</option>
                        </select>
                    </label>
                </div>
                <div class="col-md-4">
                    <label class="form-label-custom">
                        Durum
                        <select name="IsActive" class="form-control-custom">
                            <option value="True">Aktif (Portfolyoda Göster)</option>
                            <option value="False">Pasif (Gizli)</option>
                        </select>
                    </label>
                </div>
                <div class="col-md-4 d-flex align-items-end justify-content-end gap-2">
                    <button type="reset" class="btn-pastel-secondary" style="padding: 8px 14px;">İptal</button>
                    <button type="submit" class="btn-pastel-primary" style="padding: 8px 20px;">
                        <i class="bi bi-check-lg"></i>
                        <span>Kaydet</span>
                    </button>
                </div>
            </div>
        </form>
                    </div>
                </main>

<div class="modal-overlay experience-delete-overlay" aria-hidden="true">
    <div class="modal-dialog-box" role="dialog" aria-modal="true" aria-label="Deneyim silme onayı" style="max-width: 460px;">
        <div class="p-4">
            <h2 class="h5 mb-2">Deneyimi Sil</h2>
            <p class="mb-0"><span class="delete-experience-title"></span> adlı deneyimi silmek istiyor musunuz?</p>
        </div>
        <form asp-area="Admin" asp-controller="Experience" asp-action="DeleteExperience" method="post"
              class="d-flex justify-content-end gap-2 border-top p-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" class="delete-experience-id">
            <button type="button" class="btn-pastel-secondary cancel-experience-delete">Hayır</button>
            <button type="submit" class="btn btn-danger">Evet</button>
        </form>
    </div>
</div>

<script>
    (() => {
        const overlay = document.querySelector('.experience-delete-overlay');
        const title = overlay.querySelector('.delete-experience-title');
        const idInput = overlay.querySelector('.delete-experience-id');
        const cancelButton = overlay.querySelector('.cancel-experience-delete');
        let activeTrigger;

        const closeDialog = () => {
            overlay.classList.remove('show');
            overlay.setAttribute('aria-hidden', 'true');
            activeTrigger?.focus();
        };

        document.querySelectorAll('.experience-delete-trigger').forEach((trigger) => {
            trigger.addEventListener('click', () => {
                activeTrigger = trigger;
                title.textContent = trigger.dataset.experienceTitle;
                idInput.value = trigger.dataset.experienceId;
                overlay.classList.add('show');
                overlay.setAttribute('aria-hidden', 'false');
                cancelButton.focus();
            });
        });

        cancelButton.addEventListener('click', closeDialog);
        overlay.addEventListener('click', (event) => {
            if (event.target === overlay) {
                closeDialog();
            }
        });
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && overlay.classList.contains('show')) {
                closeDialog();
            }
        });
    })();
</script>
