@{
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
@using Bportfolio.Entities
@model List<Message>

<main class="page-content-area">
    <div class="content-header-row">
        <div>
            <div class="projects-eyebrow"><i class="bi bi-envelope"></i> PORTFOLYO İLETİŞİMİ</div>
            <h1 class="page-title">Gelen Mesajlar</h1>
            <p class="page-subtitle">Ziyaretçilerden gelen mesajları görüntüleyin ve yönetin.</p>
        </div>
    </div>

    <section class="data-table-card">
        <div class="table-filter-bar">
            <div class="filters-left-group">
                <label class="filter-search-box">
                    <i class="bi bi-search"></i>
                    <input type="search" class="message-search-input" placeholder="Gönderen veya konu ara..." autocomplete="off" aria-label="Gönderen veya konuya göre ara">
                </label>
            </div>
        </div>
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table message-table">
                <thead>
                    <tr>
                        <th>Gönderen</th>
                        <th>Konu</th>
                        <th>Tarih</th>
                        <th style="text-align: right;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var rowClass = item.IsRead ? string.Empty : "message-row-unread";

                        <tr class="@rowClass" data-message-row data-message-id="@item.MessageId"
                            data-message-sender="@item.SenderName" data-message-subject="@item.Subject"
                            data-is-read="@item.IsRead.ToString().ToLowerInvariant()">
                            <td>
                                <div class="company-cell">
                                    <i class="bi bi-person-circle company-badge-icon"></i>
                                    <span class="message-sender">@item.SenderName</span>
                                </div>
                            </td>
                            <td class="message-subject">@item.Subject</td>
                            <td>@item.SendDate.ToString("dd MMM yyyy")</td>
                            <td style="text-align: right;">
                                <div class="row-actions-group justify-content-end">
                                        <button type="button" class="btn-pastel-secondary js-open-message"
                                            data-detail-url="@Url.Action("MessageDetail", "Message", new { area = "Admin", id = item.MessageId })">Mesajı Aç</button>
                                    <button type="button" class="btn-action-icon btn-delete js-delete-message" title="Sil" aria-label="@item.Subject konulu mesajı sil"
                                            data-message-id="@item.MessageId" data-message-sender="@item.SenderName" data-message-subject="@item.Subject">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</main>

<style>
    .custom-admin-table tbody tr.message-row-unread td {
        background-color: #f2f4f6;
    }

    .message-row-unread .message-sender,
    .message-row-unread .message-subject {
        font-weight: 600;
    }
</style>

<div class="modal fade" id="messageDetailModal" tabindex="-1" aria-labelledby="messageDetailModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="messageDetailModalTitle">Mesaj Detayı</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <div class="small text-secondary">GÖNDEREN</div>
                        <div class="fw-semibold" id="messageDetailSender"></div>
                        <a id="messageDetailEmail"></a>
                    </div>
                    <span class="badge" id="messageReadStatus"></span>
                </div>
                <h3 class="h6" id="messageDetailSubject"></h3>
                <div class="small text-secondary mb-3" id="messageDetailDate"></div>
                <hr>
                <p class="mb-0" id="messageDetailBody" style="white-space: pre-wrap;"></p>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-outline-secondary" id="toggleMessageReadButton">Okunmadı olarak işaretle</button>
                <button type="button" class="btn-pastel-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<div class="modal-overlay message-delete-overlay" aria-hidden="true">
    <div class="modal-dialog-box" role="dialog" aria-modal="true" aria-label="Mesaj silme onayı" style="max-width: 460px;">
        <div class="p-4">
            <h2 class="h5 mb-2">Mesajı Sil</h2>
            <p class="mb-0"><strong class="delete-message-subject"></strong> konulu, <strong class="delete-message-sender"></strong> tarafından gönderilen mesajı silmek istiyor musunuz?</p>
        </div>
        <form asp-area="Admin" asp-controller="Message" asp-action="DeleteMessage" method="post" class="d-flex justify-content-end gap-2 border-top p-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" class="delete-message-id">
            <button type="button" class="btn-pastel-secondary cancel-message-delete">Hayır</button>
            <button type="submit" class="btn btn-danger">Evet</button>
        </form>
    </div>
</div>

<script>
    (() => {
        const detailModalElement = document.getElementById('messageDetailModal');
        const detailModal = new bootstrap.Modal(detailModalElement);
        const detailSender = document.getElementById('messageDetailSender');
        const detailEmail = document.getElementById('messageDetailEmail');
        const detailSubject = document.getElementById('messageDetailSubject');
        const detailDate = document.getElementById('messageDetailDate');
        const detailBody = document.getElementById('messageDetailBody');
        const readStatus = document.getElementById('messageReadStatus');
        const toggleReadButton = document.getElementById('toggleMessageReadButton');
        const searchInput = document.querySelector('.message-search-input');
        let currentMessageId;
        let currentIsRead;

        const updateReadState = (isRead) => {
            currentIsRead = isRead;
            readStatus.textContent = isRead ? 'Okundu' : 'Okunmadı';
            readStatus.className = `badge ${isRead ? 'text-bg-success' : 'text-bg-secondary'}`;
            toggleReadButton.textContent = isRead ? 'Okunmadı olarak işaretle' : 'Okundu olarak işaretle';

            const row = document.querySelector(`[data-message-row][data-message-id="${currentMessageId}"]`);
            if (row) {
                row.dataset.isRead = String(isRead);
                row.classList.toggle('message-row-unread', !isRead);
            }
        };

        document.querySelectorAll('.js-open-message').forEach((button) => {
            button.addEventListener('click', async () => {
                detailBody.textContent = 'Mesaj yükleniyor...';
                detailModal.show();

                try {
                    const response = await fetch(button.dataset.detailUrl, {
                        cache: 'no-store',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    if (!response.ok) throw new Error('Mesaj yüklenemedi.');

                    const message = await response.json();
                    currentMessageId = message.messageId;
                    detailSender.textContent = message.senderName;
                    detailEmail.textContent = message.senderEmail;
                    detailEmail.href = `mailto:${message.senderEmail}`;
                    detailSubject.textContent = message.subject;
                    detailDate.textContent = message.sendDate;
                    detailBody.textContent = message.messageDetail;
                    updateReadState(message.isRead);
                } catch {
                    detailBody.textContent = 'Mesaj yüklenirken bir hata oluştu.';
                }
            });
        });

        searchInput.addEventListener('input', () => {
            const query = searchInput.value.toLocaleLowerCase('tr-TR').trim();
            document.querySelectorAll('[data-message-row]').forEach((row) => {
                const sender = row.dataset.messageSender.toLocaleLowerCase('tr-TR');
                const subject = row.dataset.messageSubject.toLocaleLowerCase('tr-TR');
                row.hidden = !sender.includes(query) && !subject.includes(query);
            });
        });

        toggleReadButton.addEventListener('click', async () => {
            const token = document.querySelector('.message-delete-overlay input[name="__RequestVerificationToken"]').value;
            const formData = new FormData();
            formData.append('id', currentMessageId);
            formData.append('__RequestVerificationToken', token);

            const response = await fetch('@Url.Action("ToggleRead", "Message", new { area = "Admin" })', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (response.ok) {
                const result = await response.json();
                updateReadState(result.isRead);
            }
        });

        const overlay = document.querySelector('.message-delete-overlay');
        const subject = overlay.querySelector('.delete-message-subject');
        const sender = overlay.querySelector('.delete-message-sender');
        const idInput = overlay.querySelector('.delete-message-id');
        const cancelButton = overlay.querySelector('.cancel-message-delete');
        let activeTrigger;

        const closeDialog = () => {
            overlay.classList.remove('show');
            overlay.setAttribute('aria-hidden', 'true');
            activeTrigger?.focus();
        };

        document.querySelectorAll('.js-delete-message').forEach((trigger) => {
            trigger.addEventListener('click', () => {
                activeTrigger = trigger;
                subject.textContent = trigger.dataset.messageSubject;
                sender.textContent = trigger.dataset.messageSender;
                idInput.value = trigger.dataset.messageId;
                overlay.classList.add('show');
                overlay.setAttribute('aria-hidden', 'false');
                cancelButton.focus();
            });
        });

        cancelButton.addEventListener('click', closeDialog);
        overlay.addEventListener('click', (event) => {
            if (event.target === overlay) closeDialog();
        });
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && overlay.classList.contains('show')) closeDialog();
        });
    })();
</script>